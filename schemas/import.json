{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitshepherds/seams/schemas/import/v1",
  "title": "seams import catalog-info --json",
  "description": "What the import did to each seam, or chose not to do.",
  "type": "object",
  "required": ["schema", "changes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://github.com/bitshepherds/seams/schemas/import/v1" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seam", "action", "message"],
        "additionalProperties": false,
        "properties": {
          "seam": { "type": "string", "description": "The seam's id, or the API's name where no seam was made." },
          "action": { "enum": ["added", "filled", "disagrees", "skipped"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}

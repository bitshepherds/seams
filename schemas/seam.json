    "rung": { "$ref": "https://github.com/bitshepherds/seams/schemas/status/v1#/$defs/rung" },
    "top": { "$ref": "https://github.com/bitshepherds/seams/schemas/register/v1#/$defs/top" },
    "gaps": { "$ref": "https://github.com/bitshepherds/seams/schemas/status/v1#/$defs/gaps" }
  }
}
